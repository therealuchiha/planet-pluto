# PLANET PLUTO Environment Configuration

# 1. Supabase Project URL & Anon/Publishable Key
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional (Supabase new publishable key format)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_...

# 2. AniList GraphQL API (Optional override, defaults to https://graphql.anilist.co)
# NEXT_PUBLIC_ANILIST_API_URL=https://graphql.anilist.co
